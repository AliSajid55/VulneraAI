# Copy this file to .env and fill in your values.

# Model folder to use (relative to the project, or an absolute path).
# Put best_info.json from training inside it so the tuned threshold is used.
MODEL_DIR=model_v3

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polyguard

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
# How long a login stays valid (hours)
JWT_EXPIRES_HOURS=24

# Gemini (optional, for AI explanations)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120
